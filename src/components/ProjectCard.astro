---
import '../styles/global.css';
import '../styles/tokens.css';
import type { CollectionEntry } from 'astro:content';

import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { id, data } = project;
const { title, img, description, technologies, status } = data;
// Collection ids are "en/foo" / "es/foo"; the public route drops the locale folder
const href = localizePath(`/projects/${id.split('/')[1]}`, lang);

// The schema stores English enum values; only the label is localized
const statusStyles = {
  developed: "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20",
  "in-development": "bg-amber-500/10 text-amber-600 border border-amber-500/20",
};

const statusLabels = {
  developed: t('projects.status.developed'),
  "in-development": t('projects.status.in-development'),
};
---

<a
  href={href}
  class="block transform transition duration-300 hover:scale-105"
>
  <Card className="group h-full flex flex-col cursor-pointer bg-[var(--color90-lowcontrast)] text-card-foreground border rounded-xl shadow-sm hover:shadow-[0_0_20px_var(--accent)]">

    <CardHeader className="p-0">
      <CardTitle className="p-0">
        <img
          class="w-full h-[196px] lg:h-[220px] object-cover shrink-0 rounded-t-xl"
          src={img}
          alt={title}
          loading="lazy"
          decoding="async"
        />
      </CardTitle>
    </CardHeader>

    <CardContent className="px-4 flex flex-col">
      <div class="flex items-center justify-between gap-2">
        <h3
          class="
            text-left
            text-xl font-semibold leading-tight
            text-[var(--accent)]
            transition-colors duration-300
            group-hover:text-[var(--accent-glow)]
          "
        >
          {title}
        </h3>

        <span
          class={`shrink-0 text-xs font-medium rounded-full px-2 py-0.5 ${
            statusStyles[status] ??
            "bg-muted text-muted-foreground border border-border"
          }`}
        >
          {statusLabels[status] ?? status}
        </span>
      </div>

      <p class="mt-2 text-sm font-medium w-full">
        {description}
      </p>
    </CardContent>

    <CardFooter className="flex flex-col mt-2">
      <h4
        class="
          text-center
          text-lg font-semibold mb-1
          text-[var(--accent)]
          transition-colors duration-300
          group-hover:text-[var(--accent-glow)]
        "
      >
        {t('projects.technologiesUsed')}
      </h4>
      <p class="text-center text-sm font-bold w-full">
        {technologies.join(', ')}
      </p>
    </CardFooter>

  </Card>
</a>
