---
import NavLink from "./NavLink.astro";
import { getNavLinks } from "../i18n/utils";

const navLinks = getNavLinks(Astro.url);
---

  <ul class="hidden sm:flex m-0 gap-[10px] items-center text-[12px] md:text-[16px] lg:text-[24px] font-medium tracking-(--tracking-tightest)">
    {navLinks.map((link) => (
      <li>
        <NavLink link={link} class="pr-4" />
      </li>
    ))}
  </ul>
